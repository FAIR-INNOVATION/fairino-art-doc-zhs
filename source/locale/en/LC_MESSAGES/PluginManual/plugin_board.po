msgstr "interfacedexhands2_slavenum"

#: ../../source/PluginManual/plugin_board.rst:502
msgid "右臂灵巧手实际反馈的电机数量。"
msgstr ""
"The actual number of motors fed back by the dexterous hand on the right arm."

#: ../../source/PluginManual/plugin_board.rst:504
msgid "interfacedexhands2_movedone"
msgstr "interfacedexhands2_movedone"

#: ../../source/PluginManual/plugin_board.rst:506
msgid "右臂灵巧手整体运动完成标志。1表示全部电机运动到位，0表示尚未全部到位。"
msgstr ""
"Right arm dexterous hand overall motion completion flag. 1 indicates that "
"all motors have moved into position, 0 indicates that not all have moved "
"into position."

#: ../../source/PluginManual/plugin_board.rst:508
msgid "interfacedexhands2_curpos"
msgstr "interfacedexhands2_curpos"

#: ../../source/PluginManual/plugin_board.rst:510
msgid "右臂灵巧手各电机的当前位置，使用设备协议定义的绝对位置单位。"
