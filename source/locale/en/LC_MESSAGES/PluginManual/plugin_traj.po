#: ../../source/PluginManual/plugin_traj.rst:163
msgid "轨迹记录与复现使用案例："
msgstr "Trajectory recording and replay use cases:"

#: ../../source/PluginManual/plugin_traj.rst:165
#, python-brace-format
msgid ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'SetTPDStart(0,0,traj1,2)'}\"    // 轨迹记录开始\n"
"\n"
"/* 按住拖动按钮进入拖动 */\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'SetTPDEnd(0)'}\"    // 轨迹记录结束\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现"
msgstr ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'SetTPDStart(0,0,traj1,2)'}\"    // Trajectory recording starts\n"
"\n"
"/* Hold and drag the button to enter dragging */\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'SetTPDEnd(0)'}\"    // Trajectory recording ends\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'LoadTPD(0,traj1)'}\"    // Trajectory preloading\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // Move to the starting point of the trajectory\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'MoveTPD(0,traj1,10)'}\"    // Trajectory replay"

#: ../../source/PluginManual/plugin_traj.rst:180
msgid "笛卡尔点动轨迹微调使用案例："
msgstr "Descartes point motion trajectory fine-tuning use case:"

#: ../../source/PluginManual/plugin_traj.rst:182
#, python-brace-format
msgid ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现\n"
"\n"
"/* 运动到待微调位置 */\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'StopMotion(0)'}\"    // 轨迹复现停止运动\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'StartJOG(0,1,1,1,10,10,10,1)'}\"    // 笛卡尔点动，延基坐标系X轴正方向最大移动1mm\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1006, command: 'SetTPDUpdate(0,traj1,1,2)'}\"    // 笛卡尔点动轨迹微调保存\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1007, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1008, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1009, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现"
msgstr ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'LoadTPD(0,traj1)'}\"    // trajectory preloading\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // move to the starting point of the trajectory\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'MoveTPD(0,traj1,10)'}\"    // trajectory reproduction\n"
"\n"
"/* move to the position for fine-tuning */\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'StopMotion(0)'}\"    // stop movement of trajectory reproduction\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'StartJOG(0,1,1,1,10,10,10,1)'}\"    // Cartesian jogging, along the base coordinate systemXmaximum movement in the positive direction of the axis1mm\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1006, command: 'SetTPDUpdate(0,traj1,1,2)'}\"    // save fine-tuning of Cartesian jogging trajectory\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1007, command: 'LoadTPD(0,traj1)'}\"    // trajectory preloading\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1008, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // move to the starting point of the trajectory\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1009, command: 'MoveTPD(0,traj1,10)'}\"    // trajectory reproduction"

#: ../../source/PluginManual/plugin_traj.rst:200
msgid "拖动示教轨迹微调使用案例："
msgstr "Drag teaching trajectory fine-tuning use case:"

#: ../../source/PluginManual/plugin_traj.rst:202
#, python-brace-format
msgid ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现\n"
"\n"
"/* 运动到待微调位置 */\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'StopMotion(0)'}\"    // 轨迹复现停止运动\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'SetTPDStart(0,0,traj1_tmp,2)'}\"    // 微调轨迹记录开始,注意轨迹命名格式，原轨迹+”_tmp”\n"
"/* 按住拖动按钮进入拖动 */\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1006, command: 'SetTPDEnd(0)'}\"    // 微调轨迹记录结束\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1007, command: 'SetTPDUpdate(0,traj1,2,2)'}\"    // 拖动示教轨迹微调保存，注意轨迹文件名称\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1008, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1009, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1010, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现"
msgstr ""
"source install/setup.bash\n"
"\n"
