#: ../../source/ART7Manual/art_line.rst:85
msgid "名称：**注意**"
msgstr "Name:**Note**"

#: ../../source/ART7Manual/art_line.rst:89
msgid "24V、48V供电电源请自备。"
msgstr "Please provide your own power supply for 24V and 48V."

#: ../../source/ART7Manual/art_line.rst:90
msgid "上位机调试网线请自备。"
msgstr "Please provide your own Ethernet cable for host computer debugging."

#: ../../source/ART7Manual/art_line.rst:91
msgid "控制器和分支器之间的网线请自备。"
msgstr ""
"Please provide your own network cable between the controller and the "
"splitter."
