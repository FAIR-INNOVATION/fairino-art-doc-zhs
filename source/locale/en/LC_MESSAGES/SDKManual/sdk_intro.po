#: ../../source/SDKManual/sdk_intro.rst:184
msgid "笛卡尔空间直线运动代码示例-单臂"
msgstr "Cartesian Space Linear Motion Code Example – Single Arm"

#: ../../source/SDKManual/sdk_intro.rst:186
#, python-brace-format, python-format
msgid ""
"int MoveLTest()\n"
"{\n"
"    SingleRobot robot(SingleRobot::ART3_R7, SingleRobot::LeftArm);        // 实例化机械臂\n"
"\n"
"    // 笛卡尔空间直线运动轨迹规划\n"
"    double j0_left[7] = {10, 10, 10, 10, 10, -10, 10};\n"
"    double desc_pos1_left[6] = {148.545536, 14.373573, 791.612359, 14.266475, 4.332141, 29.863598};\n"
"    double armAngle1_left = 351.959826;\n"
"    double velocity = 20;\n"
"    double acceleration = 20;\n"
"    robot.SetSpeed(10);     // 设置最大运动速度\n"
"    robot.SetAccScale(10);  // 设置运动加速度\n"
"    char errMsg[1024];\n"
"    ARMErrorCode rtnCode = robot.MoveJ(j0_left, velocity, acceleration, errMsg);  // 运动到直线轨迹起点\n"
"    if (rtnCode != ARMErrorCode::Success)\n"
"    {\n"
"        return -1;\n"
"    }\n"
"    // 判断运动是否完成\n"
"    while(true)\n"
"    {\n"
"        std::this_thread::sleep_for(std::chrono::milliseconds(1000));\n"
"        uint8_t state;\n"
"        robot.GetRobotMotionDone(state);\n"
"        if (state == 1)\n"
"        {\n"
"            break;\n"
"        }\n"
"    }\n"
"\n"
"    memset(errMsg, 0, 1024);\n"
"    rtnCode = robot.MoveL(desc_pos1_left, armAngle1_left, velocity, acceleration, errMsg);\n"
"    if (rtnCode != ARMErrorCode::Success)\n"
"    {\n"
"        return -1;\n"
"    }\n"
"    // 判断运动是否完成\n"
"    while(true)\n"
"    {\n"
"        std::this_thread::sleep_for(std::chrono::milliseconds(1000));\n"
"        uint8_t state;\n"
"        robot.GetRobotMotionDone(state);\n"
"        if (state == 1)\n"
"        {\n"
"            break;\n"
"        }\n"
"    }\n"
"    printf(\"moveL errorcode: %d\\n\", rtnCode);\n"
"\n"
"    return 0;\n"
"}"
msgstr ""
"int MoveLTest()\n"
"{\n"
"    SingleRobot robot(SingleRobot::ART3_R7, SingleRobot::LeftArm);        // Instantiate the robotic arm\n"
"\n"
"    // Cartesian-space linear motion trajectory planning\n"
"    double j0_left[7] = {10, 10, 10, 10, 10, -10, 10};\n"
"    double desc_pos1_left[6] = {148.545536, 14.373573, 791.612359, 14.266475, 4.332141, 29.863598};\n"
"    double armAngle1_left = 351.959826;\n"
"    double velocity = 20;\n"
"    double acceleration = 20;\n"
"    robot.SetSpeed(10);     // Set maximum motion speed\n"
"    robot.SetAccScale(10);  // Set motion acceleration\n"
"    char errMsg[1024];\n"
"    ARMErrorCode rtnCode = robot.MoveJ(j0_left, velocity, acceleration, errMsg);  // Move to the starting point of the linear trajectory\n"
"    if (rtnCode != ARMErrorCode::Success)\n"
"    {\n"
"        return -1;\n"
"    }\n"
"    // Check whether motion is complete\n"
"    while(true)\n"
"    {\n"
"        std::this_thread::sleep_for(std::chrono::milliseconds(1000));\n"
"        uint8_t state;\n"
"        robot.GetRobotMotionDone(state);\n"
"        if (state == 1)\n"
"        {\n"
"            break;\n"
"        }\n"
"    }\n"
"\n"
"    memset(errMsg, 0, 1024);\n"
"    rtnCode = robot.MoveL(desc_pos1_left, armAngle1_left, velocity, acceleration, errMsg);\n"
"    if (rtnCode != ARMErrorCode::Success)\n"
"    {\n"
"        return -1;\n"
"    }\n"
"    // Check whether motion is complete\n"
"    while(true)\n"
"    {\n"
"        std::this_thread::sleep_for(std::chrono::milliseconds(1000));\n"
"        uint8_t state;\n"
"        robot.GetRobotMotionDone(state);\n"
"        if (state == 1)\n"
"        {\n"
"            break;\n"
"        }\n"
"    }\n"
"    printf(\"moveL errorcode: %d\\n\", rtnCode);\n"
"\n"
"    return 0;\n"
"}"

