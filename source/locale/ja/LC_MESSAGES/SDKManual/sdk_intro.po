"* @param [in] len   笛卡尔伺服运动轨迹点个数\n"
"* @param [out] errMsg 错误信息打印\n"
"* @return 错误码\n"
"**/\n"
"ARMErrorCode ServoCart(double* servo_cartPos, uint32_t len, char errMsg[1024]);"
msgstr ""
"/**\n"
" * @brief カルテシアン空間サーボ運動\n"
" * @param [in] servo_cartPos   カルテシアンサーボ運動の軌道ポイント（エンド・フランジ座標系の位置、座標系のRPY角、ロボットアームのアーム角）、長さ7×len、単位：[mm、deg、deg]\n"
" * @param [in] len   カルテシアンサーボ運動の軌道ポイント数\n"
