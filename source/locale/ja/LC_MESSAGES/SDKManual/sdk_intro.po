#: ../../source/SDKManual/sdk_intro.rst:1245
msgid "设置电流环拖动示教调试用例"
msgstr "設定電流ループドラッグティーチデバッグケース(僅かにJK2.0ロボットアーム使用)"

#: ../../source/SDKManual/sdk_intro.rst:1247
msgid ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 建立通信\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 连接失败\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 创建单臂实例（7轴）\n"
"SingleRobot robot(ART7_R7, LeftArm);\n"
"ARMErrorCode rtnCode;\n"
"\n"
"// 3. 设置安装角度\n"
"double yangle = -90;\n"
"double zangle = 90;\n"
"rtnCode = robot.SetRobotInstallAngle(yangle, zangle);  // 注意机械臂型号不同或者左右臂安装角度不同，安装角度根据实际情况而定。\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"安装角度设置失败\" << std::endl;\n"
"}\n"
"\n"
"// 4. 设置负载质量和质心坐标\n"
"double messCenter[3] = {0.0, 0.0, 0.0};\n"
"rtnCode = robot.SetLoadcoord(1, 0.0, messCenter);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"负载质量和质心坐标设置失败\" << std::endl;\n"
"}\n"
"\n"
"// 5. 关节软限位保护开\n"
"double limitNegative[7] = {-172.0, -112.0, -172.0, -77.0, -172.0, -72.0, -87.0};\n"
"double limitPositive[7] = {172.0, 112.0, 172.0, 112.0, 172.0, 72.0, 87.0};\n"
"rtnCode = robot.SetJointSoftLimitOnOff(1);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"开启关节软限位保护失败\" << std::endl;\n"
"}\n"
"\n"
"    // 6. 电流环拖动功能打开\n"
"rtnCode = robot.SetTeachMode(1);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"电流环拖动开启失败\" << std::endl;\n"
"}\n"
"\n"
"    // 6. 电流环拖动功能打开\n"
"rtnCode = robot.SetTeachMode(0);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"电流环拖动关闭失败\" << std::endl;\n"
"}\n"
"\n"
"    // 7. 关闭通信\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"
msgstr ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 通信を確立\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 接続失敗\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. シングルアームインスタンスを作成（7軸）\n"
"SingleRobot robot(ART7_R7, LeftArm);\n"
"ARMErrorCode rtnCode;\n"
"\n"
"// 3. 取付角度を設定\n"
"double yangle = -90;\n"
"double zangle = 90;\n"
"rtnCode = robot.SetRobotInstallAngle(yangle, zangle);  // マニピュレータの型番が異なる場合や左右アームの取付角度が異なる場合は、取付角度は実際の状況に応じて設定してください。\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"取付角度の設定に失敗\" << std::endl;\n"
"}\n"
"\n"
"// 4. 負荷質量と重心座標を設定\n"
"double messCenter[3] = {0.0, 0.0, 0.0};\n"
"rtnCode = robot.SetLoadcoord(1, 0.0, messCenter);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"負荷質量と重心座標の設定に失敗\" << std::endl;\n"
"}\n"
"\n"
"// 5. 関節ソフトリミット保護オン\n"
"double limitNegative[7] = {-172.0, -112.0, -172.0, -77.0, -172.0, -72.0, -87.0};\n"
"double limitPositive[7] = {172.0, 112.0, 172.0, 112.0, 172.0, 72.0, 87.0};\n"
"rtnCode = robot.SetJointSoftLimitOnOff(1);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"関節ソフトリミット保護の有効化に失敗\" << std::endl;\n"
"}\n"
"\n"
"    // 6. 電流ループドラッグ機能オン\n"
"rtnCode = robot.SetTeachMode(1);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"電流ループドラッグの有効化に失敗\" << std::endl;\n"
"}\n"
"\n"
"    // 6. 電流ループドラッグ機能オン\n"
"rtnCode = robot.SetTeachMode(0);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    Std::cout << \"電流ループドラッグの無効化に失敗\" << std::endl;\n"
"}\n"
"\n"
"    // 7. 通信を切断\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"

