"    robot_right.SetSpeed(10);     // 最大運動速度の設定\n"
"    robot_right.SetAccScale(10);  // 運動加速度の設定\n"
"    char errMsg[1024];\n"
"    ARMErrorCode rtnCode = robot_left.MoveJ(j1_left, velocity, acceleration, errMsg);\n"
"    if (rtnCode != ARMErrorCode::Success)\n"
