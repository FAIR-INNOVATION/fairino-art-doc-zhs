#: ../../source/SDKManual/sdk_intro.rst:2263
msgid "设置指定关节运动加速度代码示例"
msgstr "指定された関節の運動加速度を設定するコード例"

#: ../../source/SDKManual/sdk_intro.rst:2265
msgid ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 建立通信\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 连接失败\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 创建单臂实例（7轴）\n"
"    SingleRobot robot(ART7_R7, SingleArm);\n"
"\n"
"// 3. 获取关节运动速度和加速度\n"
"double speed[7] = {0};\n"
"double acc[7] = {0};\n"
"ARMErrorCode rtn;\n"
"for (uint8_t i = 0; i < 7; i++)\n"
"{\n"
"rtn = robot.GetSingleAxisSpeed(i+1, speed[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"获取关节速度失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"rtn = robot.GetSingleAxisAcc(i+1, acc[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"获取关节加速度失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"}\n"
"\n"
"// 4. 设置关节运动速度和加速度\n"
"for (uint8_t i = 0; i < 7; i++)\n"
"{\n"
"rtn = robot.SetSingleAxisSpeed(i+1, speed[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"设置关节速度失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"rtn = robot.SetSingleAxisAcc(i+1, acc[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"设置关节加速度失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"}\n"
"    // 5. 清理\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"
msgstr ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 通信を確立\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 接続失敗\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. シングルアームインスタンス（7軸）を作成\n"
"    SingleRobot robot(ART7_R7, SingleArm);\n"
"\n"
"// 3. 関節の運動速度と加速度を取得\n"
"double speed[7] = {0};\n"
"double acc[7] = {0};\n"
"ARMErrorCode rtn;\n"
"for (uint8_t i = 0; i < 7; i++)\n"
"{\n"
"rtn = robot.GetSingleAxisSpeed(i+1, speed[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"関節速度の取得に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"rtn = robot.GetSingleAxisAcc(i+1, acc[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"関節加速度の取得に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"}\n"
"\n"
"// 4. 関節の運動速度と加速度を設定\n"
"for (uint8_t i = 0; i < 7; i++)\n"
"{\n"
"rtn = robot.SetSingleAxisSpeed(i+1, speed[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"関節速度の設定に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"rtn = robot.SetSingleAxisAcc(i+1, acc[i]);\n"
"if (rtn != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"関節加速度の設定に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"}\n"
"    // 5. クリア\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"

