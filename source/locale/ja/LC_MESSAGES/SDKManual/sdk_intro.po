#: ../../source/SDKManual/sdk_intro.rst:2477
msgid "灵巧手控制初始化"
msgstr "器用な手の制御初期化"

#: ../../source/SDKManual/sdk_intro.rst:2479
msgid ""
"/**\n"
"* @brief 灵巧手控制初始化。InitHand 只做本地登记，不发起网络请求，因此返回 Success 不代表设备在线；设备在线状态由后续 ActHand 与 GetHandState 确认。\n"
"* @param [in] backend 两只手共享的 TCP 后端；为空返回 TCP_ConnectErr。两只手必须传同一个实例。非空\n"
"* @param [in] config 本手配置：side / slave_id / hand_id / model。model.valid()\n"
"* @param [in] arm_controllezr_id 本手所在臂的控制器索引，由 RobotTool::GetControllerId 获取；单臂通常为 0，双臂左 0 / 右 1。\n"
"* @param [in] errMsg 失败原因，可直接打印。\n"
"* @return TCP_ConnectErr    未调用 InitHand，或后端未连接。\n"
"          SDKServer_RunErr  服务端拒绝（常见状态码 4）；检查手供电、485、末端板拓扑与 hand_id。\n"
"          CMD_RunErr        本侧执行失败（传输或解析异常）。\n"
"**/\n"
"ARMErrorCode InitHand(std::shared_ptr<DexHandTcpBackend> backend,const HandConfig& config, uint8_t arm_controller_id, char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief 器用な手の制御初期化。InitHand ローカル登録のみを行い、ネットワークリクエストは発行しないため、 Success が返されるのはデバイスがオンラインであることを意味しません；デバイスのオンライン状態は後続の ActHand と GetHandState によって確認されます。\n"
"* @param [in] backend 二つの手で共有する TCP バックエンド；空の場合、 TCP_ConnectErrを返します。二つの手には同じインスタンスを渡す必要があります。非空\n"
"* @param [in] config この手の設定：side / slave_id / hand_id / model。model.valid()\n"
"* @param [in] arm_controllezr_id この手が属する腕のコントローラーインデックスは、 RobotTool::GetControllerId から取得します；単腕では通常 0、両腕では左 0 / 右 1です。\n"
"* @param [in] errMsg 失敗の理由、直接プリント可能です。\n"
"* @return TCP_ConnectErr    未呼び出し InitHand、またはバックエンドが接続されていない。\n"
"          SDKServer_RunErr  サーバ拒否（一般的なステータスコード 4）；手の電源供給、485、末端板トポロジー、および hand_idを確認してください。\n"
"          CMD_RunErr        こちら側での実行失敗（転送または解析異常）。\n"
"**/\n"
"ARMErrorCode InitHand(std::shared_ptr<DexHandTcpBackend> backend,const HandConfig& config, uint8_t arm_controller_id, char[1024] errMsg);"

#: ../../source/SDKManual/sdk_intro.rst:2495
msgid "激活灵巧手"
msgstr "アクティブ化__PROTECT_X__"

#: ../../source/SDKManual/sdk_intro.rst:2497
msgid ""
"/**\n"
"* @brief 激活灵巧手，使能手部电机。接口使用 config.hand_id 作为寻址参数，因此两只手必须配置正确的 hand_id。\n"
"* @param [out] errMsg 失败原因，可直接打印。\n"
"* @return TCP_ConnectErr    未调用 InitHand，或后端未连接。\n"
"        SDKServer_RunErr    服务端拒绝（常见状态码 4）；检查手供电、485、末端板拓扑与 hand_id。\n"
"        CMD_RunErr  本侧执行失败（传输或解析异常）。\n"
"        CMD_OverTime        响应超时或不完整。\n"
"**/\n"
"ARMErrorCode ActHand(char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief 敏捷手をアクティブ化し、手のモーターを有効にします。インターフェースは config.hand_id をアドレス指定パラメータとして使用するため、2つの手は正しい hand_idを設定する必要があります。\n"
"* @param [out] errMsg 失敗の理由は直接印刷可能です。\n"
"* @return TCP_ConnectErr    が InitHandを呼び出していない、またはバックエンドが接続されていない場合。\n"
"        SDKServer_RunErr    サーバー側で拒否されました（一般的なステータスコード 4）；手の電源、485、末端板のトポロジー、および hand_idを確認してください。\n"
"        CMD_RunErr  この側での実行に失敗しました（送信または解析例外）。\n"
"        CMD_OverTime        応答がタイムアウトしたか不完全です。\n"
"**/\n"
"ARMErrorCode ActHand(char[1024] errMsg);"

#: ../../source/SDKManual/sdk_intro.rst:2511
msgid "复位灵巧手"
msgstr "リセット__PROTECT_X__"

#: ../../source/SDKManual/sdk_intro.rst:2513
msgid ""
"/**\n"
"* @brief 复位灵巧手，使手部电机失能。复位后运动指令会被服务端拒绝，需要重新 ActHand 才能恢复。\n"
"* @param [out] errMsg 失败原因，可直接打印。\n"
"* @return TCP_ConnectErr    未调用 InitHand，或后端未连接。\n"
"        SDKServer_RunErr    服务端拒绝。\n"
"        CMD_RunErr  本侧执行失败。\n"
"**/\n"
"ARMErrorCode ResetHand(char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief リセットデクストラスハンド、手部モーターを無効にする。リセット後、運動命令はサーバー側で拒否され、再び ActHand する必要がある。\n"
"* @param [out] errMsg 失敗の理由は直接印刷できる。\n"
"* @return TCP_ConnectErr    が呼び出されていない、またはバックエンドが接続されていない。\n"
"        SDKServer_RunErr    サーバー側で拒否された。\n"
"        CMD_RunErr  こちら側での実行に失敗した。\n"
"**/\n"
"ARMErrorCode ResetHand(char[1024] errMsg);"

#: ../../source/SDKManual/sdk_intro.rst:2526
msgid "清除本手故障"
msgstr "本手の故障をクリアする"

#: ../../source/SDKManual/sdk_intro.rst:2528
msgid ""
"/**\n"
"* @brief 清除本手故障。清除的是故障标志，不修复机械卡阻、丢步或电机损坏。\n"
"* @param [out] errMsg 失败原因，可直接打印。\n"
"* @return TCP_ConnectErr    未调用 InitHand，或后端未连接。\n"
"        SDKServer_RunErr    服务端拒绝。\n"
"        CMD_RunErr  本侧执行失败。\n"
"        CMD_OverTime        响应超时或不完整。\n"
"**/\n"
"ARMErrorCode ClearError(char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief 本手の故障をクリアします。クリアするのは故障フラグだけで、機械的な詰まり、ステップロス、またはモータの損傷は修復しません。\n"
"* @param [out] errMsg 失敗の原因は直接印刷できます。\n"
"* @return TCP_ConnectErr    が呼び出されていない、またはバックエンドが接続されていません。 InitHandサーバーが拒否しました。\n"
"        SDKServer_RunErr    この側で実行に失敗しました。\n"
"        CMD_RunErr  応答がタイムアウトしたか、不完全です。\n"
"        CMD_OverTime        "

#: ../../source/SDKManual/sdk_intro.rst:2542
msgid "控制单个关节"
msgstr "個々の関節を制御する"

#: ../../source/SDKManual/sdk_intro.rst:2544
msgid ""
"/**\n"
"* @brief 控制单个关节。接口按 (finger, joint) 经型号表映射到协议槽位，生成 mask = 1 << slot，pos/speed/force 各只包含 1 个元素。\n"
"* @param [in] finger 手指号：0 拇指、1 食指、2 中指、3 无名指、4 小指。[0, 4]\n"
"* @param [in] joint 手指号：关节号；O6 拇指 2 关节，其余手指各 1 关节。拇指 [0,1]，其余 0\n"
"* @param [in] pos 目标位置；小值弯曲、大值伸直。[0, 255]\n"
"* @param [in] speed 目标速度百分比。[0, 100]\n"
"* @param [in] force 目标力百分比。[0, 100]\n"
"* @param [out] errMsg 失败原因，可直接打印。\n"
"* @return InvalidInput_OutOfRange   手指/关节越界，语义层直接拒绝，零下发。\n"
"        TCP_ConnectErr      未调用 InitHand，或后端未连接。\n"
"        SDKServer_RunErr    服务端拒绝（常见状态码 5：手未激活、失能或反馈未就绪）。\n"
"        CMD_RunErr  本侧执行失败。\n"
"        CMD_OverTime        响应超时或不完整。\n"
"**/\n"
"ARMErrorCode MoveMotor(uint8_t finger, int joint, double pos, double speed, double force, char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief 単一の関節を制御します。インターフェースは (finger, joint) 経由でモデル表にマッピングされ、プロトコルスロットに変換され、 mask = 1 << slotが生成されます。pos/speed/force はそれぞれ 1 個の要素のみを含みます。\n"
"* @param [in] finger 指番号：0 親指、1 人差し指、2 中指、3 薬指、4 小指。[0, 4]\n"
"* @param [in] joint 指番号：関節番号；O6 親指は 2 関節、残りの指はそれぞれ 1 関節です。親指 [0,1]、残りは 0\n"
"* @param [in] pos 目標位置；小さな値は曲げる、大きな値は伸ばすことを示します。[0, 255]\n"
"* @param [in] speed 目標速度パーセンテージ。[0, 100]\n"
"* @param [in] force 目標力パーセンテージ。[0, 100]\n"
"* @param [out] errMsg 失敗理由、直接印刷可能です。\n"
"* @return InvalidInput_OutOfRange   指/関節が範囲外の場合、意味論層では直接拒否し、ゼロを送信します。\n"
"        TCP_ConnectErr      が呼び出されていない、またはバックエンドが接続されていない場合。\n"
"        SDKServer_RunErr    サーバーが拒否（一般的なステータスコード 5：手がアクティブ化されていない、無効になっている、またはフィードバックが準備できていない）。\n"
"        CMD_RunErr  こちら側での実行に失敗しました。\n"
"        CMD_OverTime        応答タイムアウトまたは不完全。\n"
"**/\n"
"ARMErrorCode MoveMotor(uint8_t finger, int joint, double pos, double speed, double force, char[1024] errMsg);"

#: ../../source/SDKManual/sdk_intro.rst:2564
msgid "控制整根手指"
msgstr "指全体を制御する"

#: ../../source/SDKManual/sdk_intro.rst:2566
msgid ""
"/**\n"
"* @brief 控制整根手指。pos/speed/force 的长度必须等于该手指的关节数，按关节号传入；接口内部按槽位升序压缩成 mask 与三段数组。\n"
"* @param [in] finger 手指号：0 拇指、1 食指、2 中指、3 无名指、4 小指。[0, 4]\n"
"* @param [in] pos 各关节目标位置。长度 = jointsOfFinger(finger)\n"
"* @param [in] speed 各关节目标速度。长度 = jointsOfFinger(finger)\n"
"* @param [in] force 各关节目标力。长度 = jointsOfFinger(finger)\n"
"* @param [in] len 数组长度，必须等于该指关节数。2（拇指）/ 1（其余）\n"
"* @param [out] errMsg 失败原因，可直接打印。\n"
"* @return InvalidInput_Nullptr      pos/speed/force 存在空指针。\n"
"        InvalidInput_OutOfRange     手指越界，或数组长度不等于关节数；零下发。\n"
"        TCP_ConnectErr      未调用 InitHand，或后端未连接。\n"
"        SDKServer_RunErr    服务端拒绝。\n"
"        CMD_RunErr  本侧执行失败。\n"
"        CMD_OverTime        响应超时或不完整。\n"
"**/\n"
"ARMErrorCode MoveFinger(uint8_t finger, double pos, double speed, double force, int len, char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief 整根手指を制御します。pos/speed/force の長さはその指の関節の数と等しくなければならず、関節番号で渡されます。インターフェース内部ではスロットの昇順で mask と3つの配列に圧縮されます。\n"
"* @param [in] finger 指の番号：0 親指、1 人差し指、2 中指、3 薬指、4 小指。[0, 4]\n"
"* @param [in] pos 各関節の目標位置。長さ = jointsOfFinger(finger)\n"
"* @param [in] speed 各関節の目標速度。長さ = jointsOfFinger(finger)\n"
"* @param [in] force 各関節の目標力。長さ = jointsOfFinger(finger)\n"
"* @param [in] len 配列の長さは、その指の関節の数と等しくなければなりません。2（親指）/ 1（その他）\n"
"* @param [out] errMsg 失敗の理由。直接印刷可能です。\n"
"* @return InvalidInput_Nullptr      pos/speed/force ヌルポインタが存在します。\n"
"        InvalidInput_OutOfRange     指が範囲外であるか、または配列の長さが関節の数と一致しない場合；ゼロ以下の発行。\n"
"        TCP_ConnectErr      呼び出されていない InitHand、またはバックエンドが接続されていません。\n"
"        SDKServer_RunErr    サーバーが拒否しました。\n"
"        CMD_RunErr  この側で実行に失敗しました。\n"
"        CMD_OverTime        応答がタイムアウトしたか、不完全です。\n"
"**/\n"
"ARMErrorCode MoveFinger(uint8_t finger, double pos, double speed, double force, int len, char[1024] errMsg);"

#: ../../source/SDKManual/sdk_intro.rst:2587
msgid "控制全部关节"
msgstr "すべての関節を制御する"

#: ../../source/SDKManual/sdk_intro.rst:2589
msgid ""
"/**\n"
"* @brief 控制全部关节。len 必须等于 model.motor_count；数组按非预留槽升序排列，接口内部生成 mask 并跳过预留槽。O6 的 motor_count=6，mask=0x003F。\n"
"* @param [in] pos 各关节目标位置。长度 = jointsOfFinger(finger)\n"
"* @param [in] speed 各关节目标速度。长度 = jointsOfFinger(finger)\n"
"* @param [in] force 各关节目标力。长度 = jointsOfFinger(finger)\n"
"* @param [in] len 数组长度，必须等于该指关节数。2（拇指）/ 1（其余）\n"
"* @param [out] errMsg 失败原因，可直接打印。\n"
"* @return InvalidInput_Nullptr      pos/speed/force 存在空指针。\n"
"        InvalidInput_OutOfRange     len <= 0，或 len 不等于 motor_count；零下发。\n"
"        TCP_ConnectErr      未调用 InitHand，或后端未连接。\n"
"        SDKServer_RunErr    服务端拒绝（常见状态码 5）。\n"
"        CMD_RunErr  本侧执行失败。\n"
"        CMD_OverTime        响应超时或不完整。\n"
"**/\n"
"ARMErrorCode MoveAllFingers(double pos, double speed, double force, int len, char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief すべての関節を制御します。len は model.motor_countと等しくなければなりません；配列は予約されていないスロットで昇順に並べられ、インターフェース内部で mask が生成され、予約されたスロットはスキップされます。O6 の motor_count=6、mask=0x003F。\n"
"* @param [in] pos 各関節の目標位置。長さ = jointsOfFinger(finger)\n"
"* @param [in] speed 各関節の目標速度。長さ = jointsOfFinger(finger)\n"
"* @param [in] force 各関節の目標力。長さ = jointsOfFinger(finger)\n"
"* @param [in] len 配列の長さは、該当する関节数と等しくなければなりません。2（親指）/ 1（その他）\n"
"* @param [out] errMsg 失敗の理由であり、直接印刷することができます。\n"
"* @return InvalidInput_Nullptr      pos/speed/force ヌルポインタが存在します。\n"
"        InvalidInput_OutOfRange     len <= 0または len が motor_countと等しくない場合；ゼロ未満で送信。\n"
"        TCP_ConnectErr      が InitHandを呼び出さなかった場合、またはバックエンドが接続されていない場合。\n"
"        SDKServer_RunErr    サーバー側で拒否されました（一般的なステータスコード 5）。\n"
"        CMD_RunErr  この側で実行に失敗しました。\n"
"        CMD_OverTime        応答がタイムアウトしたか、不完全です。\n"
"**/\n"
"ARMErrorCode MoveAllFingers(double pos, double speed, double force, int len, char[1024] errMsg);"

#: ../../source/SDKManual/sdk_intro.rst:2609
msgid "读取本手最新状态快照"
msgstr "最新の状態スナップショットを読み取る"

#: ../../source/SDKManual/sdk_intro.rst:2611
msgid ""
"/**\n"
"* @brief 读取本手最新状态快照\n"
"* @param [out] state 状态快照；stamp_ns==0 表示未取到数据。\n"
"* @param [out] errMsg 失败原因，可直接打印。\n"
"* @return CMD_OverTime      未取得状态（stamp_ns == 0）：查询失败、超时或响应字段不符。\n"
"        TCP_ConnectErr      未调用 InitHand，或后端未连接。\n"
"**/\n"
"ARMErrorCode GetHandState(HandState& state, char[1024] errMsg);"
msgstr ""
"/**\n"
"* @brief 本手の最新状態スナップショットを読み取り\n"
"* @param [out] state 状態スナップショット；stamp_ns==0 データが取得できなかったことを示します。\n"
"* @param [out] errMsg 失敗の原因、直接印刷可能です。\n"
"* @return CMD_OverTime      状態が取得できませんでした（stamp_ns == 0）：クエリ失敗、タイムアウト、または応答フィールドの不一致。\n"
"        TCP_ConnectErr      が呼び出されなかった、またはバックエンドに接続されていない場合。\n"
"**/\n"
"ARMErrorCode GetHandState(HandState& state, char[1024] errMsg);"

#: ../../source/SDKManual/sdk_intro.rst:2624
msgid "读取本手最新状态快照代码示例"
msgstr "読み取り本手最新状態スナップショットコード例"

#: ../../source/SDKManual/sdk_intro.rst:2626
msgid ""
"#include <chrono>\n"
"#include <iostream>\n"
"#include <memory>\n"
"#include <thread>\n"
"#include \"humanorid_sdk.h\"\n"
"#include \"dexhand/robot_hand.h\"\n"
"\n"
"int main() {\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != ARMErrorCode::Success) {\n"
"        std::cout << \"RPC 连接失败\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    uint8_t arm = 0;\n"
"    if (tool.GetControllerId(\"left_arm_controller\", arm) !=\n"
"        ARMErrorCode::Success) {\n"
"        std::cout << \"未找到 left_arm_controller\" << std::endl;\n"
"        tool.CloseRPC();\n"
"        return -1;\n"
"    }\n"
"\n"
"    auto backend = std::make_shared<dexhand::DexHandTcpBackend>();\n"
"    dexhand::HandConfig cfg;\n"
"    cfg.side = dexhand::HandSide::kLeft;\n"
"    cfg.slave_id = 0;\n"
"    cfg.hand_id = 1;\n"
"    cfg.model = dexhand::makeLinkerHandO6();\n"
"\n"
"    RobotHand hand;\n"
"    char err[1024] = {0};\n"
"    if (hand.InitHand(backend, cfg, arm, err) !=\n"
"            ARMErrorCode::Success ||\n"
"        hand.ActHand(err) != ARMErrorCode::Success) {\n"
"        std::cout << \"初始化/激活失败：\" << err << std::endl;\n"
"        tool.CloseRPC();\n"
"        return -1;\n"
"    }\n"
"\n"
"    const double open[6] = {254, 254, 254, 254, 254, 254};\n"
"    const double speed[6] = {30, 30, 30, 30, 30, 30};\n"
"    const double force[6] = {60, 60, 60, 60, 60, 60};\n"
"    if (hand.MoveAllFingers(open, speed, force, 6, err) !=\n"
"            ARMErrorCode::Success) {\n"
"        std::cout << \"张开失败：\" << err << std::endl;\n"
"        tool.CloseRPC();\n"
"        return -1;\n"
"    }\n"
"\n"
"    dexhand::HandState st;\n"
"    for (int i = 0; i < 30; ++i) {\n"
"        if (hand.GetHandState(st, err) == ARMErrorCode::Success &&\n"
"            st.move_done == 1) {\n"
"            break;\n"
"        }\n"
"        std::this_thread::sleep_for(std::chrono::milliseconds(300));\n"
"    }\n"
"    std::cout << \"joint_count=\" << st.joint_count\n"
"            << \" move_done=\" << st.move_done << std::endl;\n"
"\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"
msgstr ""
"#include <chrono>\n"
"#include <iostream>\n"
"#include <memory>\n"
"#include <thread>\n"
"#include \"humanorid_sdk.h\"\n"
"#include \"dexhand/robot_hand.h\"\n"
"\n"
"int main() {\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != ARMErrorCode::Success) {\n"
"        std::cout << \"RPC 接続失敗\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    uint8_t arm = 0;\n"
"    if (tool.GetControllerId(\"left_arm_controller\", arm) !=\n"
"        ARMErrorCode::Success) {\n"
"        std::cout << \"見つかりませんでした left_arm_controller\" << std::endl;\n"
"        tool.CloseRPC();\n"
"        return -1;\n"
"    }\n"
"\n"
"    auto backend = std::make_shared<dexhand::DexHandTcpBackend>();\n"
"    dexhand::HandConfig cfg;\n"
"    cfg.side = dexhand::HandSide::kLeft;\n"
"    cfg.slave_id = 0;\n"
"    cfg.hand_id = 1;\n"
"    cfg.model = dexhand::makeLinkerHandO6();\n"
"\n"
"    RobotHand hand;\n"
"    char err[1024] = {0};\n"
"    if (hand.InitHand(backend, cfg, arm, err) !=\n"
"            ARMErrorCode::Success ||\n"
"        hand.ActHand(err) != ARMErrorCode::Success) {\n"
"        std::cout << \"初期化/アクティベーション失敗：\" << err << std::endl;\n"
"        tool.CloseRPC();\n"
"        return -1;\n"
"    }\n"
"\n"
"    const double open[6] = {254, 254, 254, 254, 254, 254};\n"
"    const double speed[6] = {30, 30, 30, 30, 30, 30};\n"
"    const double force[6] = {60, 60, 60, 60, 60, 60};\n"
"    if (hand.MoveAllFingers(open, speed, force, 6, err) !=\n"
"            ARMErrorCode::Success) {\n"
"        std::cout << \"開く失敗：\" << err << std::endl;\n"
"        tool.CloseRPC();\n"
"        return -1;\n"
"    }\n"
"\n"
"    dexhand::HandState st;\n"
"    for (int i = 0; i < 30; ++i) {\n"
"        if (hand.GetHandState(st, err) == ARMErrorCode::Success &&\n"
"            st.move_done == 1) {\n"
"            break;\n"
"        }\n"
"        std::this_thread::sleep_for(std::chrono::milliseconds(300));\n"
"    }\n"
"    std::cout << \"joint_count=\" << st.joint_count\n"
"            << \" move_done=\" << st.move_done << std::endl;\n"
"\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"

#: ../../source/SDKManual/sdk_intro.rst:2694
msgid "速度前馈功能设置"
msgstr "速度フィードフォワード機能設定"

#: ../../source/SDKManual/sdk_intro.rst:2696
msgid ""
"/**\n"
"* @brief  速度前馈功能设置\n"
"* @param [in] enable 0-功能关闭，1-功能开启\n"
"* @param [in] axis 轴id 1-设置 0-不设置\n"
"* @return 错误码\n"
"**/\n"
"ARMErrorCode SetVelForwardFeed(uint8_t enable, uint8_t axis[7]);"
msgstr ""
"/**\n"
"* @brief  速度フィードフォワード機能設定\n"
"* @param [in] enable 0-機能オフ，1-機能オン\n"
"* @param [in] axis 軸id 1-設定 0-設定しない\n"
"* @return エラーコード\n"
"**/\n"
"ARMErrorCode SetVelForwardFeed(uint8_t enable, uint8_t axis[7]);"

#: ../../source/SDKManual/sdk_intro.rst:2708
msgid "速度前馈功能设置调试用例"
msgstr "速度前馈機能設定デバッグ用例"

#: ../../source/SDKManual/sdk_intro.rst:2710
msgid ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 建立通信\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 连接失败\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 创建单臂实例（7轴）\n"
"    SingleRobot robot(ART7_R7, SingleArm);\n"
"\n"
"// 3. 开启2、3、4轴速度前速前馈\n"
"uint8_t axis[7] = {0, 1, 1, 1, 0, 0, 0};\n"
"ArmErrorCode rtnCode = robot.SetVelForwardFeed(1, axis);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"速度前馈开启失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 4. 关闭2和4轴速度前速前馈\n"
"axis[1] = 0;\n"
"axis[3] = 0;\n"
"rtnCode = robot.SetVelForwardFeed(0, axis);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"速度前馈关闭失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 7. 关闭通信\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"
msgstr ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 通信を確立\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 接続失敗\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 単腕インスタンスを作成（7軸）\n"
"    SingleRobot robot(ART7_R7, SingleArm);\n"
"\n"
"// 3. 2、3、4軸の速度フィードフォワードを有効化\n"
"uint8_t axis[7] = {0, 1, 1, 1, 0, 0, 0};\n"
"ArmErrorCode rtnCode = robot.SetVelForwardFeed(1, axis);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"速度フィードフォワードの有効化に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 4. 2と4軸の速度フィードフォワードを無効化\n"
"axis[1] = 0;\n"
"axis[3] = 0;\n"
"rtnCode = robot.SetVelForwardFeed(0, axis);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"std::cout << \"速度フィードフォワードの無効化に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 7. 通信を終了\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"

