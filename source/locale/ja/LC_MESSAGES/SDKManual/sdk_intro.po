"* @return 错误码\n"
"**/\n"
"ARMErrorCode ServoJ(double* jointPos, int period, char errMsg[1024]);"
msgstr ""
"/**\n"
" * @brief ジョイント空間サーボモードによる動作\n"
" * @param [in] jointPos   目標ジョイント位置（単位：deg）\n"
" * @param [in] period     コマンド送信周期（単位：ms）\n"
" * @param [out] errMsg    エラー情報の出力\n"
" * @return エラーコード\n"
" **/\n"
"ARMErrorCode ServoJ(double* jointPos, int period, char errMsg[1024]);"

#: ../../source/SDKManual/sdk_intro.rst:536
msgid "笛卡尔空间伺服运动"
msgstr "デカルト空間サーボ運動"

#: ../../source/SDKManual/sdk_intro.rst:538
msgid ""
"/**\n"
"* @brief  笛卡尔空间伺服运动\n"
