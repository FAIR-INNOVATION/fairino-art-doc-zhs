#: ../../source/SDKManual/sdk_intro.rst:1378
msgid "设置碰撞后策略调试用例"
msgstr "衝突後の戦略デバッグケース(のみJK2.0ロボットアーム使用)"

#: ../../source/SDKManual/sdk_intro.rst:1380
msgid ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 建立通信\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 连接失败\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 创建单臂实例（7轴）\n"
"SingleRobot robot(ART7_R7, LeftArm);\n"
"ARMErrorCode rtnCode;\n"
"\n"
"// 3. 设置安装角度\n"
"double yangle = -90;\n"
"double zangle = 90;\n"
"rtnCode = robot.SetRobotInstallAngle(yangle, zangle);  // 注意机械臂型号不同或者左右臂安装角度不同，安装角度根据实际情况而定。\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"安装角度设置失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"// 4. 碰撞检测开启\n"
"rtnCode = robot.SetCollisionDetectionMode(1, 0);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"碰撞检测开启失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"// 5. 设置碰撞等级和策略\n"
"uint8_t level[7] = {5, 5, 5, 5, 5, 5, 5};  // 碰撞等级\n"
"rtnCode = robot.SetAnticollision(level);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"碰撞等级设置失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"rtnCode = robot.SetCollisionStrategy(1);  // 碰撞策略：重力矩\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"碰撞策略设置失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"// 6. 关节空间运动\n"
"double target[7] = {10, 20, 0, 0, 0, 0, 0};\n"
"char err_msg[1024];\n"
"rtnCode = robot.MoveJ(target, 30.0, 20.0, 0, err_msg);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"MoveJ运动失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 7. 碰撞检测关闭\n"
"rtnCode = robot.SetCollisionDetectionMode(0, 0);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"碰撞检测关闭失败\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 7. 关闭通信\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"
msgstr ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 通信を確立\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 接続に失敗\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 単腕インスタンス（7軸）を作成\n"
"SingleRobot robot(ART7_R7, LeftArm);\n"
"ARMErrorCode rtnCode;\n"
"\n"
"// 3. 取付角度を設定\n"
"double yangle = -90;\n"
"double zangle = 90;\n"
"rtnCode = robot.SetRobotInstallAngle(yangle, zangle);  // 注意：ロボットアームの型番が異なる場合、または左右アームの取付角度が異なる場合は、取付角度を実際の状況に応じて設定してください。\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"取付角度の設定に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"// 4. 衝突検出を有効化\n"
"rtnCode = robot.SetCollisionDetectionMode(1, 0);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"衝突検出の有効化に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"// 5. 衝突レベルとポリシーを設定\n"
"uint8_t level[7] = {5, 5, 5, 5, 5, 5, 5};  // 衝突レベル\n"
"rtnCode = robot.SetAnticollision(level);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"衝突レベルの設定に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"rtnCode = robot.SetCollisionStrategy(1);  // 衝突ポリシー：重力トルク\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"衝突ポリシーの設定に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"// 6. 関節空間運動\n"
"double target[7] = {10, 20, 0, 0, 0, 0, 0};\n"
"char err_msg[1024];\n"
"rtnCode = robot.MoveJ(target, 30.0, 20.0, 0, err_msg);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"MoveJ運動に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 7. 衝突検出を無効化\n"
"rtnCode = robot.SetCollisionDetectionMode(0, 0);\n"
"if (rtnCode != ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"衝突検出の無効化に失敗\" << std::endl;\n"
"return -1;\n"
"}\n"
"\n"
"    // 7. 通信を切断\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"

