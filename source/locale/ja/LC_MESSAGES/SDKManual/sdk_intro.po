#: ../../source/SDKManual/sdk_intro.rst:2059
msgid "力传感器数据清零调试用例"
msgstr "力センサーデータゼロクリアデバッグ用例"

#: ../../source/SDKManual/sdk_intro.rst:2061
msgid ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 建立通信\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 连接失败\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 创建单臂实例（7轴）\n"
"    SingleRobot robot(ART7_R7, SingleArm);\n"
"\n"
"    // 3. 力传感器激活\n"
"ARMErrorCode rtn = robot.FT_Activate(1);\n"
"if (ret == ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"力传感器激活执行成功\" << std::endl;\n"
"}\n"
"else\n"
"{\n"
"    std::cout << \"力传感器激活执行失败，错误码: \" << (int)ret << std::endl;\n"
"}\n"
"\n"
"// 4. 力传感器数据清零\n"
"rtn = robot.ForceSensorSetZero();\n"
"if (ret == ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"力传感器数据清零执行成功\" << std::endl;\n"
"}\n"
"else\n"
"{\n"
"    std::cout << \"力传感器数据清零执行失败，错误码: \" << (int)ret << std::endl;\n"
"}\n"
"\n"
"    // 5. 力传感器关闭\n"
"rtn = robot.FT_Activate(0);\n"
"if (ret == ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"力传感器关闭执行成功\" << std::endl;\n"
"}\n"
"else\n"
"{\n"
"    std::cout << \"力传感器关闭执行失败，错误码: \" << (int)ret << std::endl;\n"
"}\n"
"\n"
"    // 7. 清理\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"
msgstr ""
"#include <iostream>\n"
"#include \"humanorid_sdk.h\"\n"
"\n"
"int main() {\n"
"    // 1. 通信を確立\n"
"    RobotTool tool;\n"
"    if (tool.RPC(\"192.168.58.1\", 8081) != Success) {\n"
"        std::cout << \"RPC 接続失敗\" << std::endl;\n"
"        return -1;\n"
"    }\n"
"\n"
"    // 2. 単腕インスタンスを作成（7軸）\n"
"    SingleRobot robot(ART7_R7, SingleArm);\n"
"\n"
"    // 3. 力センサーを有効化\n"
"ARMErrorCode rtn = robot.FT_Activate(1);\n"
"if (ret == ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"力センサーの有効化の実行に成功\" << std::endl;\n"
"}\n"
"else\n"
"{\n"
"    std::cout << \"力センサーの有効化の実行に失敗，エラーコード: \" << (int)ret << std::endl;\n"
"}\n"
"\n"
"// 4. 力センサーデータをゼロクリア\n"
"rtn = robot.ForceSensorSetZero();\n"
"if (ret == ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"力センサーデータのゼロクリアの実行に成功\" << std::endl;\n"
"}\n"
"else\n"
"{\n"
"    std::cout << \"力センサーデータのゼロクリアの実行に失敗，エラーコード: \" << (int)ret << std::endl;\n"
"}\n"
"\n"
"    // 5. 力センサーを無効化\n"
"rtn = robot.FT_Activate(0);\n"
"if (ret == ARMErrorCode::Success)\n"
"{\n"
"    std::cout << \"力センサーの無効化の実行に成功\" << std::endl;\n"
"}\n"
"else\n"
"{\n"
"    std::cout << \"力センサーの無効化の実行に失敗，エラーコード: \" << (int)ret << std::endl;\n"
"}\n"
"\n"
"    // 7. クリーンアップ\n"
"    tool.CloseRPC();\n"
"    return 0;\n"
"}"

