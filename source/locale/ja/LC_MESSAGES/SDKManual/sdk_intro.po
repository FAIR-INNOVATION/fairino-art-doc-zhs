#: ../../source/SDKManual/sdk_intro.rst:2834
msgid ""
"/**\n"
"* @brief  关节使能\n"
"* @param [in] joint_id 关节序号 0-腰部所有关节使能 1,2,...-腰部对应关节\n"
"* @return 错误码\n"
"**/\n"
"ARMErrorCode AxisEnable(int joint_id);"
msgstr ""
"/**\n"
