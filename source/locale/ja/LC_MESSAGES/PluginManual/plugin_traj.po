#: ../../source/PluginManual/plugin_traj.rst:163
msgid "轨迹记录与复现使用案例："
msgstr "軌跡記録と再現の使用ケース："

#: ../../source/PluginManual/plugin_traj.rst:165
#, python-brace-format
msgid ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'SetTPDStart(0,0,traj1,2)'}\"    // 轨迹记录开始\n"
"\n"
"/* 按住拖动按钮进入拖动 */\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'SetTPDEnd(0)'}\"    // 轨迹记录结束\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现"
msgstr ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'SetTPDStart(0,0,traj1,2)'}\"    // 軌跡記録開始\n"
"\n"
"/* ドラッグボタンを押しながらドラッグに入ります */\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'SetTPDEnd(0)'}\"    // 軌跡記録終了\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'LoadTPD(0,traj1)'}\"    // 軌跡プリロード\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 軌跡の開始点に移動\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'MoveTPD(0,traj1,10)'}\"    // 軌跡再現"

#: ../../source/PluginManual/plugin_traj.rst:180
msgid "笛卡尔点动轨迹微调使用案例："
msgstr "デカルト点動軌跡微調整の使用例："

#: ../../source/PluginManual/plugin_traj.rst:182
#, python-brace-format
msgid ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现\n"
"\n"
"/* 运动到待微调位置 */\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'StopMotion(0)'}\"    // 轨迹复现停止运动\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'StartJOG(0,1,1,1,10,10,10,1)'}\"    // 笛卡尔点动，延基坐标系X轴正方向最大移动1mm\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1006, command: 'SetTPDUpdate(0,traj1,1,2)'}\"    // 笛卡尔点动轨迹微调保存\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1007, command: 'LoadTPD(0,traj1)'}\"    // 轨迹预加载\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1008, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 运动到轨迹起点\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1009, command: 'MoveTPD(0,traj1,10)'}\"    // 轨迹复现"
msgstr ""
"source install/setup.bash\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1001, command: 'LoadTPD(0,traj1)'}\"    // 軌跡プリロード\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1002, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 軌跡の開始点へ移動\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1003, command: 'MoveTPD(0,traj1,10)'}\"    // 軌跡再現\n"
"\n"
"/* 微調整位置へ移動 */\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1004, command: 'StopMotion(0)'}\"    // 軌跡再現停止移動\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1005, command: 'StartJOG(0,1,1,1,10,10,10,1)'}\"    // デカルトポイント動的、基座標系沿いにX軸正方向最大移動1mm\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1006, command: 'SetTPDUpdate(0,traj1,1,2)'}\"    // デカルトポイント動的軌跡微調整保存\n"
"\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1007, command: 'LoadTPD(0,traj1)'}\"    // 軌跡プリロード\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1008, command: 'MoveToTPDStart(0,traj1,0,50)'}\"    // 軌跡の開始点へ移動\n"
"ros2 action send_goal /fairino_sdk/execute_command fairino_sdk_server_interfaces/action/ExecuteCommand \"{client_request_id: 1009, command: 'MoveTPD(0,traj1,10)'}\"    // 軌跡再現"

